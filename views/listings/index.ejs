<% layout("/layouts/boilerplate")%>



  <!-- Hero -->
  <section class="hero">
    <div>
      <h1>Scan your plant, get instant care tips</h1>
      <p>Identify any plant, find out what it needs, and buy the right fertilizer in one place.</p>
      <div class="hero-buttons">
 <a href="/scan" class="btn btn-primary btn-lg">📷 Scan now</a>
<a href="/shop" class="btn btn-lg">Browse fertilizers</a>
      </div>
    </div>
   <img src="https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=800" alt="Green plant leaves">
  </section>

  <!-- How it works -->
  <section class="section">
    <div class="container">
      <h2>How it works</h2>
      <div class="grid-3">
        <div class="step">
          <div class="step-icon">&#11014;</div>
          <h3>1. Upload photo</h3>
          <p>Take or upload a picture of your plant.</p>
        </div>
        <div class="step">
          <div class="step-icon">&#128269;</div>
          <h3>2. Get details</h3>
          <p>See the plant name and its health status.</p>
        </div>
        <div class="step">
          <div class="step-icon">&#128722;</div>
          <h3>3. Buy fertilizer</h3>
          <p>Order the fertilizer we recommend.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Popular fertilizers -->
  <section class="section">
    <div class="container">
      <h2>Popular fertilizers</h2>
      <div class="grid-3">
        <div class="product">
          <img src="https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=400" alt="Nitrogen mix">
          <div class="product-info">
            <div><h3>Nitrogen mix</h3><p>Rs 299</p></div>
           <a href="/cart" class="btn btn-primary">Add to cart</a>
          </div>
        </div>
        <div class="product">
          <img src="https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?w=400" alt="Organic compost">
          <div class="product-info">
            <div><h3>Organic compost</h3><p>Rs 199</p></div>
           <a href="/cart" class="btn btn-primary">Add to cart</a>
          </div>
        </div>
        <div class="product">
          <img src="https://images.unsplash.com/photo-1466692476868-aef1dfb1e735?w=400" alt="Bloom booster">
          <div class="product-info">
            <div><h3>Bloom booster</h3><p>Rs 349</p></div>
            <a href="/cart" class="btn btn-primary">Add to cart</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <span>PlantCare, minor project</span>
    <span>Contact</span>
    <span>Privacy</span>
  </footer>


